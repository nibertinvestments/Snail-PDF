* {
  box-sizing: border-box;
}

:root {
  font-family: Inter, 'Segoe UI', sans-serif;
  line-height: 1.5;
  font-weight: 400;
  color: #e2e8f0;
  background: #020817;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  min-height: 100vh;
  background:
    radial-gradient(circle at top, rgba(59, 130, 246, 0.18), transparent 35%),
    linear-gradient(160deg, #020817 0%, #0f172a 100%);
}

button, textarea, input {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  width: min(1550px, calc(100vw - 32px));
  margin: 24px auto;
  display: grid;
  gap: 20px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 20px 22px;
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.16);
  border-radius: 18px;
  box-shadow: 0 18px 45px rgba(15, 23, 42, 0.25);
}

.eyebrow {
  margin: 0 0 4px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-size: 11px;
  color: #93c5fd;
}

.topbar h1 {
  margin: 0;
  font-size: clamp(1.7rem, 2vw, 2.6rem);
}

.actions-group {
  display: flex;
  align-items: center;
  gap: 12px;
}

button.primary,
button.secondary,
button.tool-button,
.sidebar button {
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 12px;
  font-weight: 600;
  transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
}

button.primary {
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  color: white;
  padding: 0.8rem 1.3rem;
  box-shadow: 0 14px 28px rgba(37, 99, 235, 0.28);
}

button.secondary,
.sidebar button {
  background: rgba(15, 23, 42, 0.75);
  color: #e2e8f0;
  padding: 0.8rem 1.1rem;
}

button:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

button:hover:not(:disabled) {
  transform: translateY(-1px);
  border-color: rgba(96, 165, 250, 0.7);
}

.workspace {
  display: grid;
  grid-template-columns: 320px minmax(0, 1fr);
  gap: 20px;
  min-height: 75vh;
}

.sidebar {
  display: grid;
  gap: 18px;
}

.panel-card {
  border: 1px solid rgba(148, 163, 184, 0.16);
  border-radius: 18px;
  background: rgba(15, 23, 42, 0.82);
  padding: 18px;
  box-shadow: 0 12px 24px rgba(15, 23, 42, 0.2);
}

.panel-card h2 {
  margin: 0 0 14px;
  font-size: 1rem;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.tool-button {
  background: rgba(15, 23, 42, 0.8);
  color: #e2e8f0;
  padding: 0.7rem 0.75rem;
}

.tool-button.active {
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.25), rgba(59, 130, 246, 0.12));
  border-color: rgba(96, 165, 250, 0.7);
}

.zoom-row,
.page-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.zoom-row {
  margin-bottom: 14px;
}

.zoom-row span,
.page-nav span {
  font-variant-numeric: tabular-nums;
}

textarea {
  width: 100%;
  resize: vertical;
  min-height: 120px;
  border-radius: 12px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  background: rgba(15, 23, 42, 0.8);
  color: #f8fafc;
  padding: 0.8rem 0.9rem;
}

.viewer-shell {
  min-width: 0;
  border: 1px solid rgba(148, 163, 184, 0.16);
  border-radius: 18px;
  background: rgba(15, 23, 42, 0.78);
  box-shadow: 0 18px 45px rgba(15, 23, 42, 0.25);
  padding: 16px;
}

.page-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14px;
  margin-bottom: 16px;
  padding: 0.6rem 0.9rem;
  border-radius: 12px;
  border: 1px solid rgba(148, 163, 184, 0.16);
  background: rgba(2, 6, 23, 0.34);
  color: #cbd5e1;
}

.page-container {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 720px;
  border-radius: 16px;
  border: 1px solid rgba(148, 163, 184, 0.14);
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.78), rgba(15, 23, 42, 0.52));
  overflow: auto;
  padding: 18px;
  user-select: none;
}

.page-canvas {
  display: block;
  max-width: 100%;
  box-shadow: 0 24px 56px rgba(2, 6, 23, 0.45);
  background: white;
}

.annotation-layer {
  position: absolute;
  inset: 18px;
  pointer-events: none;
}

.annotation {
  position: absolute;
  pointer-events: none;
}

.text-annotation {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid rgba(47, 111, 237, 0.8);
  background: rgba(255, 255, 255, 0.88);
  color: #0f172a;
  font-size: 0.75rem;
  font-weight: 600;
  padding: 0.5rem;
  border-radius: 10px;
  box-shadow: 0 8px 16px rgba(47, 111, 237, 0.18);
  overflow: hidden;
}

.highlight-annotation {
  border-radius: 6px;
  opacity: 0.8;
  box-shadow: inset 0 0 0 1px rgba(17, 24, 39, 0.12);
}

.draw-annotation {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.empty-state {
  min-height: 620px;
  display: grid;
  place-items: center;
}

.empty-card {
  width: min(560px, calc(100% - 32px));
  border-radius: 20px;
  padding: 2.2rem;
  text-align: center;
  border: 1px solid rgba(148, 163, 184, 0.18);
  background: rgba(15, 23, 42, 0.75);
}

.empty-card h2 {
  margin: 0 0 12px;
  font-size: clamp(1.5rem, 2vw, 2.2rem);
}

.empty-card p {
  color: #cbd5e1;
  margin: 0;
}

.status-banner {
  margin-bottom: 16px;
  padding: 0.9rem 1rem;
  border-radius: 12px;
  border: 1px solid rgba(239, 68, 68, 0.5);
  background: rgba(127, 29, 29, 0.2);
  color: #fecaca;
}

@media (max-width: 980px) {
  .workspace {
    grid-template-columns: 1fr;
  }

  .topbar {
    flex-direction: column;
    align-items: flex-start;
  }

  .actions-group {
    width: 100%;
    justify-content: flex-start;
    flex-wrap: wrap;
  }
}

@media (max-width: 640px) {
  .app-shell {
    width: min(100vw - 20px, 100%);
    margin: 12px auto 24px;
  }

  .page-container {
    min-height: 520px;
    padding: 12px;
  }

  .page-toolbar {
    flex-direction: column;
    align-items: flex-start;
  }
}
